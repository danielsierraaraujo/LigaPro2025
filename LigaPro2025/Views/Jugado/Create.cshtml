@model LigaPro2025.Models.Jugador
@{
    var equipo = ViewBag.Equipo as LigaPro2025.Models.Equipo;
    ViewData["Title"] = "Agregar Jugador a " + equipo.Nombre;
}
<h2>@ViewData["Title"]</h2>
<form asp-action="Create" method="post">
    <input type="hidden" asp-for="EquipoId" />
    <div class="form-group">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="NumeroCamiseta"></label>
        <input asp-for="NumeroCamiseta" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Goles"></label>
        <input asp-for="Goles" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Asistencias"></label>
        <input asp-for="Asistencias" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Sueldo"></label>
        <input asp-for="Sueldo" class="form-control" />
    </div>
    <div class="form-check">
        <input asp-for="Titular" class="form-check-input" />
        <label asp-for="Titular" class="form-check-label">Titular</label>
    </div>
    <button type="submit" class="btn btn-primary mt-3">Guardar</button>
    <a asp-action="Index" asp-route-equipoId="@equipo.Id" class="btn btn-secondary mt-3">Cancelar</a>
</form>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}