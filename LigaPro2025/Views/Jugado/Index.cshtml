@model IEnumerable<LigaPro2025.Models.Jugador>
@{
    ViewData["Title"] = "Jugadores Titulares";
    var equipoId = ViewBag.EquipoId;
    var equipoNombre = ViewBag.EquipoNombre;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center">
            <img src="~/img/logos/@equipoNombre.ToLower().Replace(" ", "")-logo.png" alt="Logo @equipoNombre"
                 style="height: 50px; margin-right: 15px;" />
            <h2 class="mb-0">@equipoNombre - Jugadores Titulares</h2>
        </div>
        <a class="btn btn-success" asp-action="Create" asp-route-equipoId="@equipoId">+ Agregar Jugador</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">No hay jugadores titulares registrados para este equipo.</div>
    }
    else
    {
        <table class="table table-hover table-striped">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Nombre</th>
                    <th>Posición</th>
                    <th>Edad</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var jugador in Model)
                {
                    <tr>
                        <td>@jugador.Id</td>
                        <td>@jugador.Nombre</td>
                        <td>@jugador.Posicion</td>
                        <td>@jugador.Edad</td>
                        <td>
                            <form asp-action="Delete" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@jugador.Id" />
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Estás seguro de eliminar a este jugador?');">
                                    Eliminar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
