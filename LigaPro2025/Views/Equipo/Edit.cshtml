@model LigaPro2025.Models.Equipo
@{
    ViewData["Title"] = "Editar Equipo";
}
<h2>@ViewData["Title"]</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" disabled />
    </div>
    <div class="form-row">
        <div class="col">
            <label asp-for="PartidosJugados"></label>
            <input asp-for="PartidosJugados" class="form-control" />
        </div>
        <div class="col">
            <label asp-for="PartidosGanados"></label>
            <input asp-for="PartidosGanados" class="form-control" />
        </div>
        <div class="col">
            <label asp-for="PartidosEmpatados"></label>
            <input asp-for="PartidosEmpatados" class="form-control" />
        </div>
        <div class="col">
            <label asp-for="PartidosPerdidos"></label>
            <input asp-for="PartidosPerdidos" class="form-control" />
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-success">Guardar</button>
        <a asp-action="ListaEquipos" class="btn btn-secondary">Cancelar</a>
    </div>
</form>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}